filters:
  and:
    - file.folder == "PapersRecap"
    - file.hasTag("paper")
properties:
  file.name:
    displayName: 📄 论文标题
  paper-year:
    displayName: 📅 年份
  read-date:
    displayName: 🗓️ 阅读日期
  aliases:
    displayName: 🏷️ 简称
  tags:
    displayName: 🔖 标签
  related:
    displayName: 🔗 Foundation
  paper-pdf:
    displayName: 📎 论文PDF
  note.read-date:
    displayName: 编辑时间
  note.paper-pdf:
    displayName: 原文链接
views:
  - type: table
    name: 📚 全部论文（按年份）
    groupBy:
      property: paper-year
      direction: DESC
    order:
      - file.name
      - read-date
      - paper-pdf
    sort:
      - property: read-date
        direction: ASC
      - property: paper-pdf
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 450
  - type: table
    name: 🗓️ 按阅读日期
    groupBy:
      property: read-date
      direction: DESC
    order:
      - file.name
      - read-date
      - paper-year
      - paper-pdf
      - aliases
      - related
  - type: table
    name: 🔗 按 Foundation 领域
    filters:
      and:
        - related.length > 0
    order:
      - file.name
      - read-date
      - paper-year
      - paper-pdf
      - related
  - type: cards
    name: 🤖 灵巧操作核心
    filters:
      or:
        - file.hasTag("dexterous-manipulation")
        - file.hasTag("in-hand-manipulation")
        - file.hasTag("tactile-sensing")
    order:
      - file.name
      - read-date
      - paper-year
      - paper-pdf
      - aliases
  - type: table
    name: 🎮 强化学习相关
    filters:
      or:
        - file.hasTag("reinforcement-learning")
        - file.hasTag("safe-RL")
        - file.hasTag("model-based-RL")
    order:
      - file.name
      - read-date
      - paper-year
      - paper-pdf
      - aliases
      - related
  - type: table
    name: 🔄 Sim-to-Real
    filters:
      or:
        - file.hasTag("sim-to-real")
        - file.hasTag("domain-randomization")
    order:
      - file.name
      - read-date
      - paper-year
      - paper-pdf
      - related
  - type: list
    name: 📖 最近添加
    order:
      - file.name
      - read-date
      - paper-year
      - paper-pdf
    limit: 10
